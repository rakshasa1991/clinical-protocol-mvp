# Database (PostgreSQL for production)
# Get this from Vercel Storage, PlanetScale, or Supabase
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-me-with-random-string-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# AI Gateway
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_BASE_URL="https://aigateway.biocad.ru/api/v2"
OPENAI_MODEL="InHouse/Qwen3.5-122B"

# SSL (optional - disable if gateway has self-signed cert)
NODE_TLS_REJECT_UNAUTHORIZED=0
